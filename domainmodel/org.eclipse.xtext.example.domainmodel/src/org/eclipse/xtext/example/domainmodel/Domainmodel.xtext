grammar org.eclipse.xtext.example.domainmodel.Domainmodel with jbase.Jbase

import "http://www.eclipse.org/xtext/xbase/Xbase" as xbase

generate domainmodel "http://www.xtext.org/example/Domainmodel"
import "http://www.Jbase.jbase" as jbase

DomainModel:
	importSection=XImportSection?
	elements+=AbstractElement*;

AbstractElement:
	PackageDeclaration | Entity;

PackageDeclaration:
	'package' name=QualifiedName '{'
		elements+=AbstractElement*
	'}';

Entity:
	'entity' name=ValidID ('extends' superType=JvmParameterizedTypeReference)? '{'
		features+=Feature*
	'}';

Feature:
	Property | Operation;

Property:
	name=ValidID ':' type=JvmTypeReference;

Operation:
	annotations+=XAnnotation*
	'op' name=ValidID '(' (params+=FullJvmFormalParameter (',' params+=FullJvmFormalParameter)*)? ')' (':' type=JvmTypeReference)?
		body=XBlockExpression;

@Override
XJAnonymousClassBody returns jbase::XJAnonymousClassBody:
	{AnonymousClassBody} features+=Feature*;

// Local declarations use the host's member syntax and are block contents.
@Override
XJStatementOrBlock returns xbase::XExpression:
	LocalClass | =>XBlockExpression | XJSingleStatement;

LocalClass returns jbase::XJLocalClass:
	{LocalClass} 'class' name=ValidID
	('extends' superType=JvmParameterizedTypeReference)?
	('implements' interfaces+=JvmParameterizedTypeReference
		(',' interfaces+=JvmParameterizedTypeReference)*)?
	'{' body=XJAnonymousClassBody '}';
