  <eClassifiers xsi:type="ecore:EClass" name="XJMethodReference" eSuperTypes="../../../org.eclipse.xtext.xbase/model/Xbase.ecore#//XClosure">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Java method or constructor reference. Extending XClosure lets Xbase defer functional interface typing in generic and overloaded calls. The inherited lambda body and parameter lists are not used: JbaseMethodReferences matches executable signatures, and the compiler emits native Java reference syntax to preserve receiver evaluation and super dispatch."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="receiver" eType="ecore:EClass ../../../org.eclipse.xtext.xbase/model/Xbase.ecore#//XExpression" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The expression qualifier, such as text in text::trim or the syntactic name String in String::length. Linking distinguishes type literals from bound receivers. This feature is unset for qualifiers represented by type."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="type" eType="ecore:EClass ../../../org.eclipse.xtext.common.types/model/JavaVMTypes.ecore#//JvmTypeReference" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An unambiguous parameterized or array type qualifier, including parameterized outer types with inner types. Simple type names use receiver and are recognized as type literals during linking."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="member" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The referenced method name or the keyword new. It remains syntactic text because executable selection depends on the functional interface target, overloads, and generic inference."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="typeArguments" upperBound="-1" eType="ecore:EClass ../../../org.eclipse.xtext.common.types/model/JavaVMTypes.ecore#//JvmTypeReference" containment="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Explicit executable type arguments written after the double colon. Type arguments before the double colon belong to the qualifying type instead."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="executable" eType="ecore:EClass ../../../org.eclipse.xtext.common.types/model/JavaVMTypes.ecore#//JvmExecutable" transient="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The selected executable, applied after type inference and omitted from serialization. Synthetic array constructor and array clone signatures have no executable and leave this link null."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
