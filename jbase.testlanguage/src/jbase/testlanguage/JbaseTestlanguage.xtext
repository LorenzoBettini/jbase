grammar jbase.testlanguage.JbaseTestlanguage with jbase.Jbase

generate jbaseTestlanguage "http://www.testlanguage.jbase/JbaseTestlanguage"
import "http://www.eclipse.org/xtext/xbase/Xbase" as xbase
import "http://www.Jbase.jbase" as jbase

/**
 * This is only a test language for Jbase used in jbase.tests for testing things
 * like imports, methods, fields, etc.
 */

JbaseTestLanguageModel:
	importSection=XImportSection?
	properties+=Property* // correspond to Java fields
	methods+=OpMethod* // correspond to Java methods
	operations+=Operation* // correspond to Java static methods
	block=SpecialBlockExpression;

SpecialBlockExpression returns xbase::XBlockExpression:
	{xbase::XBlockExpression}
	(expressions+=XJTestlanguageStatementOrBlock)*;

// The unbraced test-language root also parses fields as name: Type. Restrict labels
// here to blocks and basic for loops, which cannot be confused with a type reference.
XJTestlanguageStatementOrBlock returns xbase::XExpression:
	=>XBlockExpression | XJTestlanguageSingleStatement;

XJTestlanguageSingleStatement returns xbase::XExpression:
	=>XJTestlanguageLabeledStatement |
	->XSwitchExpression |
	XJSemicolonStatement |
	XIfExpression |
	XForLoopExpression |
	XBasicForLoopExpression |
	XWhileExpression |
	XJTryWithResourcesStatement |
	XTryCatchFinallyExpression |
	XSynchronizedExpression |
	XJEmptyStatement;

XJTestlanguageLabeledStatement returns xbase::XExpression:
	{jbase::XJLabeledStatement} name=ID ':' statement=(XBlockExpression
			| XBasicForLoopExpression | XWhileExpression);

Property:
	annotations+=XAnnotation*
	name=ValidID ':' type=JvmTypeReference;

OpMethod:
	'method'
	annotations+=XAnnotation* // to avoid ambiguity with Property we put annotations after 'method'
	name=ValidID '(' (params+=FullJvmFormalParameter (',' params+=FullJvmFormalParameter)*)? ')'
						(':' type=JvmTypeReference)? 
		body=XBlockExpression;

Operation:
	'op' name=ValidID '(' (params+=FullJvmFormalParameter (',' params+=FullJvmFormalParameter)*)? ')'
						(':' type=JvmTypeReference)? 
		body=XBlockExpression;

AbstractOperation:
	OpMethod | Operation
;

@Override 
FeatureCallID:
	ValidID;

@Override
XJAnonymousClassBody returns jbase::XJAnonymousClassBody:
	{AnonymousClassBody} properties+=Property* methods+=OpMethod*
;
